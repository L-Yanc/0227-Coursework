diff --git a/pyslam/depth_estimation/pred_depth.py b/pyslam/depth_estimation/pred_depth.py
new file mode 100644
index 0000000..067d245
--- /dev/null
+++ b/pyslam/depth_estimation/pred_depth.py
@@ -0,0 +1,168 @@
+# this file contains the predicted depth for mono SLAM 
+# all off unless the CW1_* env vars are set here
+import os
+import threading
+import time
+from collections import deque
+
+import cv2
+import numpy as np
+
+from pyslam.depth_estimation.depth_sampling import depth_at_keypoints
+
+METHOD = os.environ.get("CW1_METHOD", "").upper()  # "normal", "B", "E1", "B+E1"
+PRED = os.environ.get("CW1_PRED_DEPTH", "")  
+FACTOR = float(os.environ.get("CW1_DEPTH_FACTOR", "0"))  
+SIGMA_PCT = float(os.environ.get("CW1_SIGMA_PCT", "100"))  
+DEPTH_UNTIL = int(os.environ.get("CW1_DEPTH_UNTIL", "0"))  
+LOG_DIR = os.environ.get("CW1_LOG_POINTS", "")  
+COS_MAX_PARALLAX = 
+
+_lock = threading.Lock()
+_files = None
+_cache = {}
+
+
+def use(m):
+    return m.upper() in METHOD.split("+")
+
+
+def ts_of(f):
+    t = f.timestamp
+    return t() if callable(t) else t
+
+
+def allowed(kf):
+    return DEPTH_UNTIL <= 0 or kf.kid < DEPTH_UNTIL
+
+
+def _load_list():
+    global _files
+    base = os.path.dirname(os.path.abspath(PRED))
+    ts, paths = [], []
+    for line in open(PRED):
+        f = line.split()
+        if len(f) >= 4 and not line.startswith("#"):
+            ts.append(float(f[0]))
+            paths.append(os.path.join(base, f[3]))
+    o = np.argsort(ts)
+    _files = (np.array(ts)[o], [paths[i] for i in o])
+
+
+def depth(timestamp):
+    if not PRED or FACTOR <= 0:
+        return None
+    with _lock:
+        if _files is None:
+            _load_list()
+        ts, paths = _files
+        i = int(np.argmin(np.abs(ts - timestamp)))
+        if abs(ts[i] - timestamp) > 1e-3:
+            return None
+        if i not in _cache:
+            if len(_cache) > 20:
+                _cache.clear()
+            d = cv2.imread(paths[i], cv2.IMREAD_UNCHANGED)
+            _cache[i] = None if d is None else d.astype(np.float32) / FACTOR
+        return _cache[i]
+
+
+def sigma_grad(d):
+    # same sigma_d 
+    g = np.hypot(cv2.Sobel(d, cv2.CV_32F, 1, 0, ksize=3), cv2.Sobel(d, cv2.CV_32F, 0, 1, ksize=3)) / 8
+    return cv2.dilate(g, np.ones((5, 5), np.uint8))
+
+
+def _at_keypoints(d, uv):
+    z = depth_at_keypoints(d, uv, "median", 5)
+    g = depth_at_keypoints(sigma_grad(d), uv, "nearest")
+    ok = z > 0
+    if SIGMA_PCT < 100 and ok.any():
+        ok &= g <= np.percentile(g[ok], SIGMA_PCT)
+    return z, g, ok
+
+
+def trusted(d, uv):
+    z, _, ok = _at_keypoints(d, uv)
+    return z, ok
+
+
+# this section of code contains learned depth fills the matches triangulation drops for too little parallax ----
+
+_scales = deque(maxlen=7)  
+_kf = {"kid": None}
+_log = None
+
+
+def on():
+    return use("B") or bool(LOG_DIR)
+
+
+def _kf_depth(kf):
+    if _kf["kid"] != kf.kid:
+        d = depth(ts_of(kf))
+        _kf.update(kid=kf.kid, z=None)
+        if d is not None:
+            _kf["z"], _kf["g"], _kf["ok"] = _at_keypoints(d, np.asarray(kf.kps))
+    return _kf["z"], _kf.get("g"), _kf.get("ok")
+
+
+def fill_gaps(map, kf_cur, kf, idxs_cur, idxs, pts3d, added, far_points_threshold=None):
+    if not on() or len(idxs_cur) == 0:
+        return []
+    z_all, g_all, ok_all = _kf_depth(kf_cur)
+    if z_all is None:
+        return []
+    idxs_cur, idxs = np.asarray(idxs_cur), np.asarray(idxs)
+    n = len(idxs_cur)
+    added = np.zeros(n, bool) if added is None else np.asarray(added, bool)
+    d_hat, g, ok = z_all[idxs_cur], g_all[idxs_cur], ok_all[idxs_cur]
+
+    # parallax of each match
+    r1 = np.c_[kf_cur.kpsn[idxs_cur], np.ones(n)] @ np.asarray(kf_cur.Rwc()).T
+    r2 = np.c_[kf.kpsn[idxs], np.ones(n)] @ np.asarray(kf.Rwc()).T
+    cos = np.sum(r1 * r2, 1) / np.linalg.norm(r1, axis=1) / np.linalg.norm(r2, axis=1)
+    low = cos > COS_MAX_PARALLAX
+
+    # map scale from the well triangulated points of this pair
+    Tcw = np.asarray(kf_cur.pose())
+    z_tri = (np.asarray(pts3d) @ Tcw[:3, :3].T + Tcw[:3, 3])[:, 2]
+    good = added & ~low & (d_hat > 0) & (z_tri > 0)
+    if good.sum() >= 20:
+        _scales.append(float(np.median(d_hat[good] / z_tri[good])))
+    s = float(np.median(_scales)) if _scales else 0.0 
+
+    cand = ~added & low & ok & (s > 0) & use("B") & allowed(kf_cur)
+    b_added = np.zeros(n, bool)
+    new = []
+    if cand.any():
+        pc = np.c_[kf_cur.kpsn[idxs_cur[cand]], np.ones(cand.sum())] * (d_hat[cand] / s)[:, None]
+        Twc = np.linalg.inv(Tcw)
+        pw = np.ascontiguousarray(pc @ Twc[:3, :3].T + Twc[:3, 3])
+        args = (pw, np.ones(len(pw), bool), kf_cur, kf, idxs_cur[cand], idxs[cand], kf_cur.img)
+        try:  
+            _, m, new = map.add_points(*args, do_check=True, cos_max_parallax=1.0, far_points_threshold=far_points_threshold)
+        except TypeError:
+            _, m, new = map.add_points(*args, True, 1.0, far_points_threshold)
+        b_added[np.where(cand)[0][np.asarray(m, bool)]] = True
+
+    if LOG_DIR:
+        _write_log(kf_cur, kf, idxs_cur, cos, z_tri, s, d_hat, g, ok, added, low, cand, b_added)
+    return list(new)
+
+
+def _write_log(kf_cur, kf, idxs_cur, cos, z_tri, s, d_hat, g, ok, added, low, cand, b_added):
+    global _log
+    if _log is None:
+        os.makedirs(LOG_DIR, exist_ok=True)
+        _log = open(os.path.join(LOG_DIR, f"points_{time.strftime('%Y%m%d-%H%M%S')}_{os.getpid()}.csv"), "w")
+        _log.write("kf,kf2,t,u,v,parallax_deg,z_tri_units,m_per_unit,z_tri_m,d_hat_m,sigma_grad,trusted,"
+                   "tri_added,low_parallax,b_candidate,b_added\n")
+    uv = np.asarray(kf_cur.kps)[idxs_cur]
+    par = np.degrees(np.arccos(np.clip(cos, -1, 1)))
+    t = ts_of(kf_cur)
+    for i in range(len(idxs_cur)):
+        _log.write(f"{kf_cur.kid},{kf.kid},{t:.6f},{uv[i,0]:.1f},{uv[i,1]:.1f},{par[i]:.4f},{z_tri[i]:.5f},{s:.5f},"
+                   f"{z_tri[i]*s:.4f},{d_hat[i]:.4f},{g[i]:.5f},{int(ok[i])},{int(added[i])},{int(low[i])},"
+                   f"{int(cand[i])},{int(b_added[i])}\n")
+    _log.flush()
