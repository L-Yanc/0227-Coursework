diff --git a/pyslam/depth_estimation/part4_policy.py b/pyslam/depth_estimation/part4_policy.py
new file mode 100644
--- /dev/null
+++ b/pyslam/depth_estimation/part4_policy.py
@@ -0,0 +1,88 @@
+"""Causal Part 4 extension to Part 3 B insertion; no reference/true-depth input.
+
+The untouched Part 3 variant bypasses this gate. Thresholds are fitted only on
+past development-interval pair discrepancies and frozen on entry to evaluation.
+"""
+import json
+from pathlib import Path
+import numpy as np
+
+class ConsistencyGate:
+    def __init__(self, split_time, min_samples=30, min_relative_threshold=.05,
+                 mad_multiplier=3.):
+        self.split=float(split_time); self.minimum=int(min_samples)
+        self.floor=float(min_relative_threshold); self.multiplier=float(mad_multiplier)
+        self.samples=[]; self.threshold=None
+        self.frozen=False; self.records=[]
+
+    def decide(self,timestamp,discrepancies):
+        values=np.asarray(discrepancies,float); valid=np.isfinite(values)&(values>=0)
+        development=timestamp<=self.split and not self.frozen
+        if development:
+            # Development observes without rejecting; later thresholds are frozen.
+            self.samples.extend(values[valid].tolist())
+            return np.ones(len(values),bool)
+        if not self.frozen:
+            self.frozen=True
+            if len(self.samples)>=self.minimum:
+                a=np.asarray(self.samples); med=np.median(a)
+                self.threshold=max(self.floor,float(med+self.multiplier*1.4826*np.median(abs(a-med))))
+        # Insufficient development evidence means no intervention, explicitly logged.
+        return np.ones(len(values),bool) if self.threshold is None else (~valid | (values<=self.threshold))
+
+    def report(self):
+        return {'development_end_timestamp':self.split,'development_samples':len(self.samples),
+                'frozen':self.frozen,'relative_threshold':self.threshold,
+                'status':'active' if self.threshold is not None else 'insufficient_development_evidence',
+                'protocol':'Pairwise learned 3D discrepancy in the current online map; first interval trains, later interval uses a frozen median+MAD threshold. Missing pair depth passes unchanged.'}
+
+class Runtime:
+    def __init__(self,parameters,frames,policy,out,temporal):
+        self.policy=policy; self.out=Path(out); self.allowed={};self.loaded=set();self.delivered=set();self.rows=[]
+        self.parameters=parameters
+        times=[float(r['timestamp']) for r in frames]
+        opts={k:v for k,v in temporal.items() if k not in ('enabled','development_fraction')}
+        self.gate=ConsistencyGate(min(times)+(max(times)-min(times))*temporal.get('development_fraction',.5),**opts) if temporal.get('enabled') else None
+
+    def before_frame(self,frame,timestamp,fallback):
+        self.allowed[round(timestamp,6)]=self.policy!='stride5' or frame%5==0 or fallback
+
+    def permits(self,timestamp):
+        return self.allowed.get(round(float(timestamp),6),False)
+
+    def record_depth(self,timestamp): self.loaded.add(round(float(timestamp),6))
+
+    def filter_candidates(self,pred,kf_cur,kf,idxs_cur,idxs,d_hat,scale,candidates):
+        if self.gate is None or not np.any(candidates): return candidates
+        t=float(pred.ts_of(kf_cur)); other=pred.depth(pred.ts_of(kf))
+        if other is None or scale<=0: return candidates
+        ids=np.flatnonzero(candidates)
+        z,ok=pred.trusted(other,np.asarray(kf.kps)[np.asarray(idxs)[ids]])
+        uv1=np.asarray(kf_cur.kpsn)[np.asarray(idxs_cur)[ids]]
+        uv2=np.asarray(kf.kpsn)[np.asarray(idxs)[ids]]
+        a=np.c_[uv1,np.ones(len(ids))]*d_hat[ids,None]
+        b=np.c_[uv2,np.ones(len(ids))]*z[:,None]
+        tw1=np.linalg.inv(np.asarray(kf_cur.pose()));tw2=np.linalg.inv(np.asarray(kf.pose()))
+        wa=a@tw1[:3,:3].T+tw1[:3,3]*scale
+        wb=b@tw2[:3,:3].T+tw2[:3,3]*scale
+        discrepancy=np.linalg.norm(wa-wb,axis=1)/np.maximum((d_hat[ids]+z)/2,1e-6)
+        discrepancy[~ok]=np.nan
+        keep=self.gate.decide(t,discrepancy); result=candidates.copy(); result[ids]&=keep
+        for i,j in enumerate(ids):
+            self.rows.append({'timestamp':t,'frame_id':int(kf_cur.img_id),'other_frame_id':int(kf.img_id),
+                              'keypoint_index':int(np.asarray(idxs_cur)[j]),'relative_discrepancy':float(discrepancy[i]) if np.isfinite(discrepancy[i]) else None,
+                              'kept':bool(keep[i]),'development':t<=self.gate.split,'threshold':self.gate.threshold})
+        return result
+
+    def finish(self):
+        result={'policy':self.policy,'unique_depth_requests':len(self.loaded),'requested_timestamps':sorted(self.loaded),
+                'temporal':self.gate.report() if self.gate else {'status':'disabled'},
+                'candidate_checks':len(self.rows),'rejected_candidates':sum(not r['kept'] for r in self.rows),
+                'reference_inputs':False,'map_pose_information':'current online poses only; no final BA map used to make decisions'}
+        self.out.mkdir(parents=True,exist_ok=True)
+        (self.out/'part3_runtime.json').write_text(json.dumps(result,indent=2,allow_nan=False)+'\n')
+        with (self.out/'consistency_decisions.jsonl').open('w') as f:
+            for row in self.rows: f.write(json.dumps(row,allow_nan=False)+'\n')
+        return result
+
+runtime=None
diff --git a/pyslam/depth_estimation/pred_depth.py b/pyslam/depth_estimation/pred_depth.py
new file mode 100644
--- /dev/null
+++ b/pyslam/depth_estimation/pred_depth.py
@@ -0,0 +1,188 @@
+# predicted depth for mono SLAM (pySLAM drops depth in mono mode) + our CW1_* switches
+# all off unless the CW1_* env vars are set
+import os
+import json
+import threading
+import time
+from collections import deque
+
+import cv2
+import numpy as np
+
+from pyslam.depth_estimation.depth_sampling import depth_at_keypoints
+
+METHOD = os.environ.get("CW1_METHOD", "").upper()  # "", "B", "E1", "B+E1"
+PRED = os.environ.get("CW1_PRED_DEPTH", "")  # path to associations_<name>.txt
+FACTOR = float(os.environ.get("CW1_DEPTH_FACTOR", "0"))  # 5000 tum, 6553.5 replica, 256 kitti
+SIGMA_PCT = float(os.environ.get("CW1_SIGMA_PCT", "100"))  # only trust keypoints below this percentile of sigma_d
+DEPTH_UNTIL = int(os.environ.get("CW1_DEPTH_UNTIL", "0"))  # 0 = always, else only for the first N keyframes
+LOG_DIR = os.environ.get("CW1_LOG_POINTS", "")  # folder for the per-point log (Part 4)
+COS_MAX_PARALLAX = 0.9998  # same as Parameters.kCosMaxParallax: below ~1.15 deg triangulation gives up
+
+_lock = threading.Lock()
+_files = None
+_cache = {}
+part4_initializations = []
+
+
+def use(m):
+    return m.upper() in METHOD.split("+")
+
+
+def ts_of(f):
+    t = f.timestamp
+    return t() if callable(t) else t
+
+
+def allowed(kf):
+    return DEPTH_UNTIL <= 0 or kf.kid < DEPTH_UNTIL
+
+
+def _load_list():
+    global _files
+    if PRED.endswith('.json'):
+        entries=json.load(open(PRED))
+        ordered=sorted(entries,key=lambda e:float(e['timestamp']))
+        _files=(np.array([float(e['timestamp']) for e in ordered]),[e['path'] for e in ordered])
+        return
+    base = os.path.dirname(os.path.abspath(PRED))
+    ts, paths = [], []
+    for line in open(PRED):
+        f = line.split()
+        if len(f) >= 4 and not line.startswith("#"):
+            ts.append(float(f[0]))
+            paths.append(os.path.join(base, f[3]))
+    o = np.argsort(ts)
+    _files = (np.array(ts)[o], [paths[i] for i in o])
+
+
+from pyslam.depth_estimation import part4_policy
+
+def depth(timestamp):
+    """predicted depth (metres, H x W) of the frame at this timestamp, None if there isn't one"""
+    if part4_policy.runtime is not None and not part4_policy.runtime.permits(timestamp):
+        return None
+    if not PRED or FACTOR <= 0:
+        return None
+    with _lock:
+        if _files is None:
+            _load_list()
+        ts, paths = _files
+        i = int(np.argmin(np.abs(ts - timestamp)))
+        if abs(ts[i] - timestamp) > 1e-3:
+            return None
+        if i not in _cache:
+            if len(_cache) > 20:
+                _cache.clear()
+            d = cv2.imread(paths[i], cv2.IMREAD_UNCHANGED)
+            _cache[i] = None if d is None else d.astype(np.float32) / FACTOR
+        if part4_policy.runtime is not None and _cache[i] is not None:
+            part4_policy.runtime.record_depth(timestamp)
+        return _cache[i]
+
+
+def sigma_grad(d):
+    # same sigma_d as part2_sigma.py: depth gradient, worst value in a 5x5 window
+    g = np.hypot(cv2.Sobel(d, cv2.CV_32F, 1, 0, ksize=3), cv2.Sobel(d, cv2.CV_32F, 0, 1, ksize=3)) / 8
+    return cv2.dilate(g, np.ones((5, 5), np.uint8))
+
+
+def _at_keypoints(d, uv):
+    z = depth_at_keypoints(d, uv, "median", 5)
+    g = depth_at_keypoints(sigma_grad(d), uv, "nearest")
+    ok = z > 0
+    if SIGMA_PCT < 100 and ok.any():
+        ok &= g <= np.percentile(g[ok], SIGMA_PCT)
+    return z, g, ok
+
+
+def trusted(d, uv):
+    """learned depth at the keypoints (median 5x5) + mask of the ones we trust (sigma_d under the percentile)"""
+    z, _, ok = _at_keypoints(d, uv)
+    return z, ok
+
+
+# ---- B: learned depth fills the matches triangulation drops for too little parallax ----
+
+_scales = deque(maxlen=7)  # recent metres-per-map-unit estimates
+_kf = {"kid": None}
+_log = None
+
+
+def on():
+    return use("B") or bool(LOG_DIR)
+
+
+def _kf_depth(kf):
+    # net depth, sigma_d and trust mask at every keypoint of kf (once per keyframe)
+    if _kf["kid"] != kf.kid:
+        d = depth(ts_of(kf))
+        _kf.update(kid=kf.kid, z=None)
+        if d is not None:
+            _kf["z"], _kf["g"], _kf["ok"] = _at_keypoints(d, np.asarray(kf.kps))
+    return _kf["z"], _kf.get("g"), _kf.get("ok")
+
+
+def fill_gaps(map, kf_cur, kf, idxs_cur, idxs, pts3d, added, far_points_threshold=None):
+    """B for one keyframe pair: returns the map points it added (and writes the point log)"""
+    if not on() or len(idxs_cur) == 0:
+        return []
+    z_all, g_all, ok_all = _kf_depth(kf_cur)
+    if z_all is None:
+        return []
+    idxs_cur, idxs = np.asarray(idxs_cur), np.asarray(idxs)
+    n = len(idxs_cur)
+    added = np.zeros(n, bool) if added is None else np.asarray(added, bool)
+    d_hat, g, ok = z_all[idxs_cur], g_all[idxs_cur], ok_all[idxs_cur]
+
+    # parallax of each match, as in Map.add_points
+    r1 = np.c_[kf_cur.kpsn[idxs_cur], np.ones(n)] @ np.asarray(kf_cur.Rwc()).T
+    r2 = np.c_[kf.kpsn[idxs], np.ones(n)] @ np.asarray(kf.Rwc()).T
+    cos = np.sum(r1 * r2, 1) / np.linalg.norm(r1, axis=1) / np.linalg.norm(r2, axis=1)
+    low = cos > COS_MAX_PARALLAX
+
+    # map scale from the well triangulated points of this pair: median(net depth / triangulated depth)
+    Tcw = np.asarray(kf_cur.pose())
+    z_tri = (np.asarray(pts3d) @ Tcw[:3, :3].T + Tcw[:3, 3])[:, 2]
+    good = added & ~low & (d_hat > 0) & (z_tri > 0)
+    if good.sum() >= 20:
+        _scales.append(float(np.median(d_hat[good] / z_tri[good])))
+    s = float(np.median(_scales)) if _scales else 0.0  # metres per map unit
+
+    cand = ~added & low & ok & (s > 0) & use("B") & allowed(kf_cur)
+    if part4_policy.runtime is not None:
+        cand = part4_policy.runtime.filter_candidates(__import__(__name__, fromlist=["depth"]), kf_cur, kf, idxs_cur, idxs, d_hat, s, cand)
+    b_added = np.zeros(n, bool)
+    new = []
+    if cand.any():
+        # along the ray of kf_cur at the net's depth, in map units
+        pc = np.c_[kf_cur.kpsn[idxs_cur[cand]], np.ones(cand.sum())] * (d_hat[cand] / s)[:, None]
+        Twc = np.linalg.inv(Tcw)
+        pw = np.ascontiguousarray(pc @ Twc[:3, :3].T + Twc[:3, 3])
+        args = (pw, np.ones(len(pw), bool), kf_cur, kf, idxs_cur[cand], idxs[cand], kf_cur.img)
+        try:  # every check of add_points except the parallax one
+            _, m, new = map.add_points(*args, do_check=True, cos_max_parallax=1.0, far_points_threshold=far_points_threshold)
+        except TypeError:
+            _, m, new = map.add_points(*args, True, 1.0, far_points_threshold)
+        b_added[np.where(cand)[0][np.asarray(m, bool)]] = True
+
+    if LOG_DIR:
+        _write_log(kf_cur, kf, idxs_cur, cos, z_tri, s, d_hat, g, ok, added, low, cand, b_added)
+    return list(new)
+
+
+def _write_log(kf_cur, kf, idxs_cur, cos, z_tri, s, d_hat, g, ok, added, low, cand, b_added):
+    global _log
+    if _log is None:
+        os.makedirs(LOG_DIR, exist_ok=True)
+        _log = open(os.path.join(LOG_DIR, f"points_{time.strftime('%Y%m%d-%H%M%S')}_{os.getpid()}.csv"), "w")
+        _log.write("kf,kf2,t,u,v,parallax_deg,z_tri_units,m_per_unit,z_tri_m,d_hat_m,sigma_grad,trusted,"
+                   "tri_added,low_parallax,b_candidate,b_added\n")
+    uv = np.asarray(kf_cur.kps)[idxs_cur]
+    par = np.degrees(np.arccos(np.clip(cos, -1, 1)))
+    t = ts_of(kf_cur)
+    for i in range(len(idxs_cur)):
+        _log.write(f"{kf_cur.kid},{kf.kid},{t:.6f},{uv[i,0]:.1f},{uv[i,1]:.1f},{par[i]:.4f},{z_tri[i]:.5f},{s:.5f},"
+                   f"{z_tri[i]*s:.4f},{d_hat[i]:.4f},{g[i]:.5f},{int(ok[i])},{int(added[i])},{int(low[i])},"
+                   f"{int(cand[i])},{int(b_added[i])}\n")
+    _log.flush()
